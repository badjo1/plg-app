<% style ||= "primary" %>
<% btn_class = style == "secondary" ? "btn-secondary" : "btn-primary" %>
<% btn_class = "#{btn_class} !px-4 !py-2 !text-xs" if local_assigns[:size] == "small" %>

<%= link_to href, target: (href.start_with?("http") ? "_blank" : nil), class: btn_class, aria: { label: text } do %>
  <span><%= text %></span><span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
<% end %>
