<%
  word = (content_for?(:grid_word) ? content_for(:grid_word) : "NFTPLGAMS").upcase
  letters = word.chars.first(9)
  letters += [" "] * (9 - letters.length) if letters.length < 9
%>
<div class="grid grid-cols-3 gap-x-5 gap-y-3 text-center" style="font-family:'Roboto Mono',monospace;">
  <% letters.each do |letter| %>
    <span class="text-4xl font-bold leading-none text-accent"><%= letter %></span>
  <% end %>
</div>
