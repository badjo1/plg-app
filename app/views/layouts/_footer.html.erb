<div class="mx-auto max-w-5xl">
  <div class="grid grid-cols-1 gap-10 sm:grid-cols-4 sm:text-left">
    <!-- 3x3 Letter Grid -->
    <div class="flex items-start justify-center sm:justify-start">
      <%= render 'layouts/letter_grid' %>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-accent"><%= t 'global.footer.about_us' %></h3>
      <ul class="space-y-1 text-sm">
        <li><%= link_to t('global.footer.who_we_are'), who_we_are_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.what_we_do'), what_we_do_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.vision'), vision_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.privacy'), privacy_path, class: "text-white hover:text-accent" %></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-accent">Playground</h3>
      <ul class="space-y-1 text-sm">
        <li><%= link_to t('global.footer.here_and_now'), now_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.get_involved'), get_involved_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.explore'), explore_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.communities'), communities_path, class: "text-white hover:text-accent" %></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-accent">Community</h3>
      <ul class="space-y-1 text-sm">
        <li><%= link_to t('global.footer.key_holders'), members_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.governance'), governance_path, class: "text-white hover:text-accent" %></li>
        <li><%= link_to t('global.footer.token'), token_path, class: "text-white hover:text-accent" %></li>
      </ul>
    </div>
  </div>

  <div class="my-8 flex items-center gap-4" aria-hidden="true">
    <span class="h-px flex-1 bg-white/20"></span>
    <span class="hand text-lg text-accent">~</span>
    <span class="h-px flex-1 bg-white/20"></span>
  </div>

  <p class="hand mt-1 text-2xl text-accent">~ <%= t('global.footer.tagline') %> ~</p>
  <p class="mt-2 text-xs text-white/60">&copy; <%= Date.today.year %> www.playground.amsterdam</p>
</div>
