<header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-7 sm:px-10">
  <a href="<%= root_path %>" class="leading-none hover:no-underline" aria-label="Playground Amsterdam home">
    <span class="hand block text-3xl font-bold tracking-tight sm:text-4xl">PLAYGROUND</span>
    <span class="mt-2 block pl-8 text-xs font-bold uppercase tracking-[.34em]">Amsterdam</span>
  </a>

  <!-- Desktop nav -->
  <nav class="hidden items-center gap-6 text-sm font-semibold sm:flex">
    <%= link_to t('global.menu.stories'), explore_path %>
    <%= link_to t('global.menu.Events'), events_path %>
    <% I18n.available_locales.each do |locale| %>
      <% unless I18n.locale == locale %>
        <%= link_to url_for(locale: locale) do %>
          <span class="flex items-center gap-1">
            <%= image_tag("flag_#{locale}.png", width: "16", height: "11", alt: t(locale, scope: 'locales'), loading: "lazy") %>
            <span><%= t(locale, scope: 'locales') %></span>
          </span>
        <% end %>
      <% end %>
    <% end %>
    <% if authenticated? %>
      <%= button_to t('global.menu.logout'), session_path, method: :delete, class: "btn-secondary !px-4 !py-2 !text-xs" %>
    <% else %>
      <%= link_to t('global.menu.login'), new_session_path, class: "btn-primary !px-4 !py-2 !text-xs" %>
    <% end %>
  </nav>

  <!-- Mobile menu button -->
  <div class="block sm:hidden">
    <button id="menu-btn" class="rounded p-2 focus:outline-none" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="h-7 w-7 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="hidden h-7 w-7 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="hidden sm:hidden">
  <nav class="mx-auto flex max-w-7xl flex-col gap-4 px-6 pb-6 text-lg font-semibold">
    <%= link_to t('global.menu.stories'), explore_path %>
    <%= link_to t('global.menu.Events'), events_path %>
    <% if authenticated? %>
      <%= button_to t('global.menu.logout'), session_path, method: :delete %>
    <% else %>
      <%= link_to t('global.menu.login'), new_session_path, class: "btn-primary text-center" %>
    <% end %>
  </nav>
</div>

<script>
  const menuToggle = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  menuToggle.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
    hamburgerIcon.classList.toggle('hidden');
    closeIcon.classList.toggle('hidden');
  });
</script>
