<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Playground Amsterdam</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f7f5e9">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="PLG">

    <% if authenticated? %>
      <meta name="current-user-id" content="<%= Current.user.id %>">
    <% end %>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Kalam:wght@400;700&family=Roboto+Mono:wght@700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <header class="w-full">
      <%= render 'layouts/header' %>
    </header>
    <%= yield :hero %>
    <main class="mx-auto max-w-5xl px-6 py-8 sm:px-10">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
    <footer class="w-full bg-forest px-6 pb-8 pt-10 text-center text-white">
      <%= render 'layouts/footer' %>
    </footer>
  </body>
</html>
