<% content_for :grid_word do %>CREATIONS<% end %>
<section class="bg-forest text-white py-16 text-center">
  <div class="max-w-4xl mx-auto px-6">
    <h1 class="text-4xl font-bold mb-4"><%= t('.title') %></h1>
    <p class="text-lg"><%= t('.subtitle') %></p>
    <a href="#get-plg" class="mt-6 inline-block bg-accent text-forest font-semibold px-6 py-3 rounded-2xl"><%= t('.get_plg') %></a>
  </div>
</section>

<section class="py-16 bg-cream">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center text-forest"><%= t('.how_title') %></h2>
    <p class="text-center text-muted mt-4 max-w-3xl mx-auto"><%= t('.how_text') %></p>
    <div class="mt-12 grid md:grid-cols-3 gap-8">
      <div class="bg-white/50 p-6 shadow rounded-2xl">
        <h3 class="text-xl font-semibold text-forest"><%= t('.keypass_title') %></h3>
        <p class="mt-4 text-muted"><%= t('.keypass_text') %></p>
      </div>
      <div class="bg-white/50 p-6 shadow rounded-2xl">
        <h3 class="text-xl font-semibold text-forest"><%= t('.visitors_title') %></h3>
        <p class="mt-4 text-muted"><%= t('.visitors_text') %></p>
      </div>
      <div class="bg-white/50 p-6 shadow rounded-2xl">
        <h3 class="text-xl font-semibold text-forest"><%= t('.exchange_title') %></h3>
        <p class="mt-4 text-muted"><%= t('.exchange_text') %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 text-center bg-forest text-white">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold"><%= t('.what_title') %></h2>
    <div class="mt-6 grid md:grid-cols-3 gap-8 text-lg">
      <div><%= t('.what_space') %></div>
      <div><%= t('.what_art') %></div>
      <div><%= t('.what_drinks') %></div>
    </div>
    <a href="#get-plg" class="mt-6 inline-block bg-accent text-forest font-semibold px-6 py-3 rounded-2xl"><%= t('.get_plg') %></a>
  </div>
</section>

<section class="py-16 bg-cream">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center text-forest"><%= t('.nft_title') %></h2>
    <p class="text-center text-muted mt-4 max-w-3xl mx-auto"><%= t('.nft_text') %></p>
    <div class="mt-10 grid md:grid-cols-2 gap-8">
      <div class="bg-white/50 p-6 shadow rounded-2xl">
        <h3 class="text-xl font-semibold text-forest"><%= t('.nft_access_title') %></h3>
        <p class="mt-4 text-muted"><%= t('.nft_access_text') %></p>
      </div>
      <div class="bg-white/50 p-6 shadow rounded-2xl">
        <h3 class="text-xl font-semibold text-forest"><%= t('.community_use_title') %></h3>
        <p class="mt-4 text-muted"><%= t('.community_use_text') %></p>
      </div>
    </div>
  </div>
</section>
