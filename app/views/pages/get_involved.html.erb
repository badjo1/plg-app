<% content_for :grid_word do %>CONNECTED<% end %>
<section class="py-16 bg-cream">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold text-forest"><%= t('.title') %></h2>
    <p class="mt-4 text-muted text-lg"><%= t('.subtitle') %></p>

    <h2 class="mt-10 text-3xl font-bold text-forest"><%= t('.global_local_title') %></h2>
    <p class="mt-4 text-muted text-lg"><%= t('.global_local_text') %></p>
  </div>
</section>

<section class="py-12">
  <div class="max-w-4xl mx-auto px-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-8 text-center">
    <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
      <h3 class="text-xl font-bold text-forest"><%= t('.create_title') %></h3>
      <p class="text-muted mb-4"><%= t('.create_text') %></p>
      <%= render 'layouts/button', text: t('.start_a_project'), href: get_involved_path %>
    </div>

    <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
      <h3 class="text-xl font-bold text-forest"><%= t('.discover_title') %></h3>
      <p class="text-muted mb-4"><%= t('.discover_text') %></p>
      <%= render 'layouts/button', text: t('.explore'), href: get_involved_path %>
    </div>

    <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl sm:col-span-2 lg:col-span-1">
      <h3 class="text-xl font-bold text-forest"><%= t('.cocreate_title') %></h3>
      <p class="text-muted mb-4"><%= t('.cocreate_text') %></p>
      <%= render 'layouts/button', text: t('.join_a_community'), href: get_involved_path %>
    </div>
  </div>
</section>
