<% content_for :grid_word do %>CONNECTED<% end %>
<section class="py-16 bg-cream">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold text-forest">Step into the Flow</h2>
    <p class="mt-4 text-muted text-lg">
      The Playground is open—where do you want to begin? Whether you're here to create, connect, or contribute, there's a place for you.
    </p>
    
    <!-- New Global-Local Knowledge Section -->
    <h2 class="mt-10 text-3xl font-bold text-forest">Local Impact, Global Knowledge</h2>
    <p class="mt-4 text-muted text-lg">
      By sharing knowledge and resources between local communities and global networks, we empower self-production and governance. 
      What is created locally flows into a global knowledge hub, allowing everyone to benefit.
    </p>
  </div>
</section>

<section class="py-12">
  <div class="max-w-4xl mx-auto px-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-8 text-center">
    
    <!-- Create Something -->
    <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
      <h3 class="text-xl font-bold text-forest">🚀 Create & Experiment</h3>
      <p class="text-muted mb-4">
        Launch your own NFT, DAO, or experiment with new ideas. The space is yours to explore.
      </p>
      <%= render 'layouts/button', text: t('.start_a_project'), href: get_involved_path %>
    </div>

    <!-- Explore & Observe -->
    <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
      <h3 class="text-xl font-bold text-forest">🔍 Discover & Connect</h3>
      <p class="text-muted  mb-4">
        Wander through the Playground, check out live projects, and experience digital art.
      </p>
      <%= render 'layouts/button', text: t('.explore'), href: get_involved_path %>
    </div>

    <!-- Join the Community -->
    <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl sm:col-span-2 lg:col-span-1">
      <h3 class="text-xl font-bold text-forest">🤝 Co-Create & Contribute</h3>
      <p class="text-muted mb-4">
        Meet creators, share knowledge, and help shape the Playground together.
      </p>
      <%= render 'layouts/button', text: t('.join_a_community'), href: get_involved_path %>
    </div>

  </div>
</section>
