<% content_for :grid_word do %>INSPIRING<% end %>

<section class="py-12">
  <div class="mx-auto max-w-3xl text-center">
    <p class="section-label mb-4"><%= t('.featured_label') %></p>
    <h1><%= t('.title') %></h1>
    <p class="mx-auto mt-4 max-w-xl text-muted"><%= t('.subtitle') %></p>
  </div>
</section>

<section class="pb-12">
  <div class="mx-auto max-w-4xl">
    <div class="relative overflow-hidden rounded-2xl border border-subtle" style="padding-top:56.25%;">
      <iframe
        src="https://iframe.mediadelivery.net/embed/460478/8a50afbd-7e31-4d00-8f37-cb5c79a5d54d?autoplay=false&preload=true"
        loading="lazy"
        style="border:none;position:absolute;top:0;left:0;width:100%;height:100%;"
        allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture"
        allowfullscreen>
      </iframe>
    </div>
  </div>
</section>

<section class="py-8">
  <div class="mx-auto max-w-2xl">
    <p><%= t('.paragraph_1') %></p>
    <p><%= t('.paragraph_2') %></p>
    <p><%= t('.paragraph_3') %></p>

    <div class="my-10 flex items-center gap-4" aria-hidden="true">
      <span class="h-px flex-1 bg-subtle"></span>
      <span class="hand text-lg">✳</span>
      <span class="h-px flex-1 bg-subtle"></span>
    </div>

    <div class="text-center">
      <p class="hand text-2xl"><%= t('.quote') %></p>
      <p class="mt-2 text-sm text-muted"><%= t('.quote_by') %></p>
    </div>
  </div>
</section>

<section class="py-12">
  <div class="mx-auto max-w-2xl">
    <h2 class="hand text-center"><%= t('.timeline') %></h2>
    <div class="mt-8 space-y-6">
      <div class="intent-card">
        <span class="section-label text-muted"><%= t('.timeline_1_date') %></span>
        <h3 class="mt-1 text-lg font-bold"><%= t('.timeline_1_title') %></h3>
        <p class="mt-1 text-sm text-muted"><%= t('.timeline_1_desc') %></p>
      </div>
      <div class="intent-card">
        <span class="section-label text-muted"><%= t('.timeline_2_date') %></span>
        <h3 class="mt-1 text-lg font-bold"><%= t('.timeline_2_title') %></h3>
        <p class="mt-1 text-sm text-muted"><%= t('.timeline_2_desc') %></p>
      </div>
      <div class="intent-card">
        <span class="section-label text-muted"><%= t('.timeline_3_date') %></span>
        <h3 class="mt-1 text-lg font-bold"><%= t('.timeline_3_title') %></h3>
        <p class="mt-1 text-sm text-muted"><%= t('.timeline_3_desc') %></p>
      </div>
      <div class="intent-card">
        <span class="section-label text-muted"><%= t('.timeline_4_date') %></span>
        <h3 class="mt-1 text-lg font-bold"><%= t('.timeline_4_title') %></h3>
        <p class="mt-1 text-sm text-muted"><%= t('.timeline_4_desc') %></p>
      </div>
      <div class="intent-card">
        <span class="section-label text-muted"><%= t('.timeline_5_date') %></span>
        <h3 class="mt-1 text-lg font-bold"><%= t('.timeline_5_title') %></h3>
        <p class="mt-1 text-sm text-muted"><%= t('.timeline_5_desc') %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-12 text-center">
  <h2 class="hand"><%= t('.cta_title') %></h2>
  <p class="mx-auto mt-4 max-w-lg text-muted"><%= t('.cta_text') %></p>
  <div class="mt-8">
    <%= render 'layouts/button', text: t('.cta_button'), href: get_involved_path %>
  </div>
</section>
