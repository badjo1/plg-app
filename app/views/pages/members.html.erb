<% content_for :grid_word do %>BELONGING<% end %>
<section class="bg-cream py-16 px-6 lg:px-24">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl font-bold text-forest"><%= t('.title') %></h1>
    <p class="mt-4 text-lg text-muted"><%= t('.subtitle') %></p>
  </div>
  <div class="bg-white/50 p-6 shadow-none border border-subtle rounded-2xl">
    <h2 class="text-2xl font-semibold text-forest"><%= t('.keypass_title') %></h2>
    <p class="mt-2 text-muted"><%= t('.keypass_text_1_html').html_safe %></p>
    <p class="mt-2 text-muted"><%= t('.keypass_text_2') %></p>
  </div>

  <div class="mt-12 grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
    <div class="bg-white/50 p-6 shadow-none border border-subtle rounded-2xl">
      <h2 class="text-2xl font-semibold text-forest"><%= t('.agenda_title') %></h2>
      <p class="mt-2 text-muted"><%= t('.agenda_text') %></p>
    </div>
    <div class="bg-white/50 p-6 shadow-none border border-subtle rounded-2xl">
      <h2 class="text-2xl font-semibold text-forest"><%= t('.space_title') %></h2>
      <p class="mt-2 text-muted"><%= t('.space_text') %></p>
    </div>
    <div class="bg-white/50 p-6 shadow-none border border-subtle rounded-2xl">
      <h2 class="text-2xl font-semibold text-forest"><%= t('.decide_title') %></h2>
      <p class="mt-2 text-muted"><%= t('.decide_text') %></p>
    </div>
    <div class="bg-white/50 p-6 shadow-none border border-subtle rounded-2xl">
      <h2 class="text-2xl font-semibold text-forest"><%= t('.more_title') %></h2>
      <p class="mt-2 text-muted"><%= t('.more_text') %></p>
    </div>
  </div>

  <div class="mt-12 text-center">
    <h2 class="text-3xl font-bold text-forest"><%= t('.how_to_join') %></h2>
    <div class="mt-6 max-w-3xl mx-auto text-muted space-y-4">
      <p>✅ <strong><%= t('.step_1') %></strong></p>
      <p>✅ <strong><%= t('.step_2') %></strong></p>
      <p>✅ <strong><%= t('.step_3') %></strong></p>
    </div>
    <a href="#" class="mt-8 inline-block bg-forest hover:bg-forest-light text-white font-semibold text-lg px-6 py-3 rounded-2xl transition duration-300">
      <%= t('.get_key') %>
    </a>
  </div>

  <div class="mt-12 bg-white/50 p-6 shadow-none border border-subtle rounded-2xl max-w-3xl mx-auto">
    <h2 class="text-2xl font-semibold text-forest"><%= t('.existing_title') %></h2>
    <p class="mt-2 text-muted"><%= t('.existing_text') %></p>
  </div>
</section>
