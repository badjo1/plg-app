<% content_for :grid_word do %>GOVERNING<% end %>
<section class="bg-forest text-white py-16 text-center">
  <div class="max-w-4xl mx-auto px-6">
    <h1 class="text-4xl font-bold mb-4"><%= t('.title') %></h1>
    <p class="text-lg"><%= t('.subtitle') %></p>
    <a href="#join" class="mt-6 inline-block bg-accent text-forest font-semibold px-6 py-3 rounded-2xl"><%= t('.join_dao') %></a>
  </div>
</section>

<section class="py-16 bg-cream">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center text-forest"><%= t('.how_title') %></h2>
    <div class="mt-10 grid md:grid-cols-2 gap-8">
      <div class="bg-white/50 p-6 shadow rounded-2xl">
        <h3 class="text-xl font-semibold text-forest"><%= t('.keypass_title') %></h3>
        <p class="mt-4 text-muted"><%= t('.keypass_text_1') %></p>
        <p class="mt-4 text-muted"><%= t('.keypass_text_2') %></p>
      </div>
      <div class="bg-white/50 p-6 shadow rounded-2xl">
        <h3 class="text-xl font-semibold text-forest"><%= t('.plg_title') %></h3>
        <p class="mt-4 text-muted"><%= t('.plg_text_1') %></p>
        <p class="mt-4 text-muted"><%= t('.plg_text_2') %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-forest text-white text-center">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold"><%= t('.decision_title') %></h2>
    <div class="mt-6 grid md:grid-cols-2 gap-8 text-lg">
      <div><%= t('.decision_keypass') %></div>
      <div><%= t('.decision_plg') %></div>
    </div>
  </div>
</section>

<section class="py-16 text-center bg-cream">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-forest"><%= t('.why_title') %></h2>
    <p class="mt-4 text-lg"><%= t('.why_text') %></p>
    <div class="mt-6 grid md:grid-cols-3 gap-8 text-lg">
      <div>✅ <%= t('.why_influence') %></div>
      <div>✅ <%= t('.why_rewards') %></div>
      <div>✅ <%= t('.why_community') %></div>
    </div>
    <a href="#join" class="mt-6 inline-block bg-accent text-forest font-semibold px-6 py-3 rounded-2xl"><%= t('.join_dao') %></a>
  </div>
</section>
