<% content_for :grid_word do %>DISCOVERY<% end %>
<section class="py-16 bg-cream">
  <div class="max-w-5xl mx-auto px-6 text-center">
    <h1 class="text-4xl font-bold text-forest"><%= t('.title') %></h1>
    <p class="mt-4 text-muted text-lg"><%= t('.subtitle') %></p>
  </div>
</section>

<section class="py-12">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-forest"><%= t('.art_title') %></h2>
    <p class="mt-2 text-muted"><%= t('.art_subtitle') %></p>
    <div class="grid md:grid-cols-3 gap-6 mt-6">
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold mt-4"><%= t('.featured_artwork') %></h3>
        <p class="text-muted"><%= t('.featured_artwork_desc') %></p>
      </div>
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold mt-4"><%= t('.curated_artists') %></h3>
        <p class="text-muted"><%= t('.curated_artists_desc') %></p>
      </div>
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold mt-4"><%= t('.ongoing_exhibitions') %></h3>
        <p class="text-muted"><%= t('.ongoing_exhibitions_desc') %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-cream">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-forest"><%= t('.projects_title') %></h2>
    <p class="mt-2 text-muted"><%= t('.projects_subtitle') %></p>
    <div class="grid md:grid-cols-2 gap-6 mt-6">
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.live_experiments') %></h3>
        <p class="text-muted"><%= t('.live_experiments_desc') %></p>
      </div>
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.collaborative_builds') %></h3>
        <p class="text-muted"><%= t('.collaborative_builds_desc') %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-12">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-forest"><%= t('.stories_title') %></h2>
    <p class="mt-2 text-muted"><%= t('.stories_subtitle') %></p>

    <%= link_to stories_path, class: "mt-6 block intent-card hover:no-underline" do %>
      <div class="flex flex-col sm:flex-row gap-5 items-start">
        <div class="relative w-full sm:w-48 shrink-0 overflow-hidden rounded-xl" style="aspect-ratio:16/9;">
          <iframe
            src="https://iframe.mediadelivery.net/embed/460478/8a50afbd-7e31-4d00-8f37-cb5c79a5d54d?autoplay=false&preload=false"
            loading="lazy"
            style="border:none;position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;"
            tabindex="-1">
          </iframe>
        </div>
        <div>
          <span class="section-label text-muted"><%= t('.featured_story') %></span>
          <h3 class="mt-1 text-xl font-bold"><%= t('.featured_story_title') %></h3>
          <p class="mt-1 text-sm text-muted"><%= t('.featured_story_desc') %></p>
          <span class="mt-2 inline-flex items-center gap-1 text-sm font-bold text-forest"><%= t('.watch_and_read') %> <span aria-hidden="true">→</span></span>
        </div>
      </div>
    <% end %>

    <div class="grid md:grid-cols-3 gap-6 mt-6">
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.founder_insights') %></h3>
        <p class="text-muted"><%= t('.founder_insights_desc') %></p>
      </div>
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.podcast_episodes') %></h3>
        <p class="text-muted"><%= t('.podcast_episodes_desc') %></p>
      </div>
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.community_spotlights') %></h3>
        <p class="text-muted"><%= t('.community_spotlights_desc') %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-cream">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-forest"><%= t('.spaces_title') %></h2>
    <p class="mt-2 text-muted"><%= t('.spaces_subtitle') %></p>
    <div class="grid md:grid-cols-3 gap-6 mt-6">
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.nft_museum') %></h3>
        <p class="text-muted"><%= t('.nft_museum_desc') %></p>
      </div>
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.co_creation_labs') %></h3>
        <p class="text-muted"><%= t('.co_creation_labs_desc') %></p>
      </div>
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.event_hall') %></h3>
        <p class="text-muted"><%= t('.event_hall_desc') %></p>
      </div>
    </div>
  </div>
</section>
