      </span>
      <p class="mt-2 text-sm text-muted">Supporting local businesses in Amsterdam to connect with the global blockchain community.</p>
      <div class="mt-4">
        <%= render 'layouts/button', text: "Explore", href: now_path, size: "small" %>
      </div>
    </div>
  </div>
</section>

<!-- Get Involved -->
