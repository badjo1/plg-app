      <div class="mt-4">
        <%= render 'layouts/button', text: "Explore", href: now_path, size: "small" %>
      </div>
    </div>

    <div class="intent-card">
      <span class="flex items-center justify-between">
        <h3 class="text-lg font-bold">Cosmolocal</h3>
        <span class="text-2xl">◎</span>
      </span>
      <p class="mt-2 text-sm text-muted">Exploring the balance between local production and global networks. Creating new connections.</p>
      <div class="mt-4">
        <%= render 'layouts/button', text: "Explore", href: "https://cosmolocal.space/", size: "small" %>
      </div>
    </div>

    <div class="intent-card">
      <span class="flex items-center justify-between">
        <h3 class="text-lg font-bold">Local Entrepreneur Onboarding</h3>
