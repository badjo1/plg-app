        <path class="sketch" d="M30 9 Q18 10 18 21 Q18 29 30 30 Q42 29 42 21 Q42 10 30 9 M30 30 L20 50 M30 30 L40 50 M10 18 L5 14 M50 18 L55 14"/>
        <path d="M24 15 Q21 22 29 25" fill="none" stroke="#80d455" stroke-width="5" stroke-linecap="round"/>
