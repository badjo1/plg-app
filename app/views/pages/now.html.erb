<% content_for :grid_word do %>EXPLORING<% end %>
<section class="py-16 bg-cream">
  <div class="max-w-5xl mx-auto px-6 text-center">
    <h1 class="text-4xl font-bold text-forest"><%= t('.title') %></h1>
    <p class="mt-4 text-muted text-lg"><%= t('.subtitle') %></p>
  </div>
</section>

<section class="py-12">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-forest"><%= t('.active_projects') %></h2>
    <p class="mt-2 text-muted"><%= t('.active_subtitle') %></p>
    <div class="grid md:grid-cols-3 gap-6 mt-6">
      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.nft_museum') %></h3>
        <p class="text-muted"><%= t('.nft_museum_desc') %></p>
        <button class="mt-4 bg-forest text-white px-4 py-2 rounded-2xl"><%= t('.more_info') %></button>
      </div>

      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.cosmolocal') %></h3>
        <p class="text-muted"><%= t('.cosmolocal_desc') %></p>
        <button class="mt-4 bg-forest text-white px-4 py-2 rounded-2xl"><%= t('.join_in') %></button>
      </div>

      <div class="bg-white/50 shadow-none border border-subtle p-6 rounded-2xl">
        <h3 class="text-xl font-semibold"><%= t('.entrepreneurs') %></h3>
        <p class="text-muted"><%= t('.entrepreneurs_desc') %></p>
        <button class="mt-4 bg-forest text-white px-4 py-2 rounded-2xl"><%= t('.connect') %></button>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-cream">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold text-forest"><%= t('.idea_title') %></h2>
    <p class="mt-2 text-muted"><%= t('.idea_text') %></p>
    <button class="mt-6 bg-forest text-white px-6 py-3 rounded-2xl text-lg font-semibold"><%= t('.start_project') %></button>
  </div>
</section>
