<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-soft mb-5 text-forest font-medium rounded-2xl inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Walls</h1>
    <%= link_to "New wall", new_wall_path, class: "rounded-2xl py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="walls" class="min-w-full">
    <%= render @walls %>
  </div>
</div>
